{
  "mcpServers": {
    "github-mcp-server": {
      "args": [
        "--secret",
        "${cmd: op read op://vault/secret}"
      ],
      "command": "github-mcp-server stdio",
      "disabled": false,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${cmd: }"
      }
    },
    "playwright": {
      "args": [
        "@playwright/mcp@latest"
      ],
      "command": "npx"
    }
  }
}
