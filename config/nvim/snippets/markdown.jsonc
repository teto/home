{
    "zola new post": {
        "prefix": [
            "zpost"
        ],
        "body": [
         "+++",
         "description='${1:desc}'",
         "title='${2:title}'",
         "tags=neovim",
         "author=Matt",
         "+++"
        ],
        "description": "New blog post header"
    }
}
