adguardhome

* hickory-dns

hickory-dns --config ./hickory-dns.toml --zonedir .

* resolvectl tricks

  # Service type + domain
  resolvectl service _ldap._tcp example.com

  # Equivalent fully qualified SRV name
  resolvectl service _ldap._tcp.example.com

  # Specific DNS-SD instance: SRV + TXT + target addresses
  resolvectl service "My Printer" _ipp._tcp local

